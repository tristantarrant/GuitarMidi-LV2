# The full description of the plugin is in this file, which is linked to from
# `manifest.ttl`.  This is done so the host only needs to scan the relatively
# small `manifest.ttl` files to quickly discover all plugins.

@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .

# X11 UI for the plugin
<http://github.com/geraldmwangi/GuitarMidi-LV2#ui>
	a ui:X11UI ;
    lv2:requiredFeature ui:idleInterface, ui:portMap, urid:map ;
	lv2:extensionData ui:idleInterface .

# First the type of the plugin is described.  All plugins must explicitly list
# `lv2:Plugin` as a type.  A more specific type should also be given, where
# applicable, so hosts can present a nicer UI for loading plugins.  Note that
# this URI is the identifier of the plugin, so if it does not match the one in
# `manifest.ttl`, the host will not discover the plugin data at all.
<http://github.com/geraldmwangi/GuitarMidi-LV2>
	a lv2:Plugin ,
		lv2:AmplifierPlugin ;
	lv2:project <http://lv2plug.in/ns/lv2> ;
	doap:name "Guitar Midi";
	doap:license <http://opensource.org/licenses/isc> ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:requiredFeature urid:map ;
	ui:ui <http://github.com/geraldmwangi/GuitarMidi-LV2#ui> ;
	lv2:port [
		a lv2:AudioPort ,
			lv2:InputPort ;
		lv2:index 0 ;
		lv2:symbol "in" ;
		lv2:name "In"
	] , [
        a lv2:OutputPort ,
            atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 1 ;
        lv2:symbol "midiout" ;
        lv2:name "MidiOut"
    ], [
	# The control defaults below are documented in README.md under
	# "Plugin Parameters"; keep the two in sync.
		a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "gain" ;
        lv2:name "Input Gain (dB)" ;
        lv2:default 28.0 ;
        lv2:minimum -20.0 ;
        lv2:maximum 40.0 ;
	],[
		a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "expressivity" ;
        lv2:name "Expressivity Range (dB)" ;
        lv2:default 3.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 20.0 ;
	],[
		a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "onsetsmoothing" ;
        lv2:name "Onset Smoothing" ;
        lv2:default 0.3 ;
        lv2:minimum 0.0 ;
        lv2:maximum 0.9 ;
	],[
		a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "offsetsmoothing" ;
        lv2:name "Offset Smoothing" ;
        lv2:default 0.3 ;
        lv2:minimum 0.0 ;
        lv2:maximum 0.9 ;
	],[
		a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "onsetconfthr" ;
        lv2:name "Onset Confidence Threshold" ;
        lv2:default 0.95 ;
        lv2:minimum 0.00 ;
        lv2:maximum 0.99 ;
	],[
		a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "offsetconfthr" ;
        lv2:name "Offset Confidence Threshold" ;
        lv2:default 0.3 ;
        lv2:minimum 0.00 ;
        lv2:maximum 0.99 ;
	],[
		a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "onsetlevel" ;
        lv2:name "Onset Level (dBFS)" ;
        lv2:default -66.0 ;
        lv2:minimum -80.0 ;
        lv2:maximum 0.0 ;
	],[
		a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "offsetlevel" ;
        lv2:name "Offset Level (dBFS)" ;
        lv2:default -66.0 ;
        lv2:minimum -80.0 ;
        lv2:maximum 0.0 ;
    ], [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports atom:Vector ;
        rsz:minimumSize 40000 ;
        lv2:index 10 ;
        lv2:symbol "debugdata" ;
        lv2:name "Note Debug Data" ;
	], [
		a lv2:OutputPort, lv2:ControlPort ;
		lv2:index 11 ;
		lv2:symbol "latency" ;
		lv2:name "Latency" ;
		lv2:designation lv2:latency ;
		lv2:portProperty lv2:integer ;
		lv2:minimum 0 ;
		lv2:maximum 65535 ;	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 12 ;
		lv2:symbol "scale" ;
		lv2:name "Scale" ;
		lv2:portProperty lv2:integer ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 17 ;
		lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ;
		lv2:scalePoint [ rdfs:label "Major" ; rdf:value 1 ] ;
		lv2:scalePoint [ rdfs:label "Natural Minor" ; rdf:value 2 ] ;
		lv2:scalePoint [ rdfs:label "Harmonic Minor" ; rdf:value 3 ] ;
		lv2:scalePoint [ rdfs:label "Melodic Minor" ; rdf:value 4 ] ;
		lv2:scalePoint [ rdfs:label "Dorian" ; rdf:value 5 ] ;
		lv2:scalePoint [ rdfs:label "Phrygian" ; rdf:value 6 ] ;
		lv2:scalePoint [ rdfs:label "Lydian" ; rdf:value 7 ] ;
		lv2:scalePoint [ rdfs:label "Mixolydian" ; rdf:value 8 ] ;
		lv2:scalePoint [ rdfs:label "Locrian" ; rdf:value 9 ] ;
		lv2:scalePoint [ rdfs:label "Major Pentatonic" ; rdf:value 10 ] ;
		lv2:scalePoint [ rdfs:label "Minor Pentatonic" ; rdf:value 11 ] ;
		lv2:scalePoint [ rdfs:label "Blues" ; rdf:value 12 ] ;
		lv2:scalePoint [ rdfs:label "Chromatic" ; rdf:value 13 ] ;
		lv2:scalePoint [ rdfs:label "Whole Tone" ; rdf:value 14 ] ;
		lv2:scalePoint [ rdfs:label "Diminished" ; rdf:value 15 ] ;
		lv2:scalePoint [ rdfs:label "Hungarian Minor" ; rdf:value 16 ] ;
		lv2:scalePoint [ rdfs:label "Phrygian Dominant" ; rdf:value 17 ]
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 13 ;
		lv2:symbol "scaleroot" ;
		lv2:name "Scale Root" ;
		lv2:portProperty lv2:integer ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 11 ;
		lv2:scalePoint [ rdfs:label "C" ; rdf:value 0 ] ;
		lv2:scalePoint [ rdfs:label "C#" ; rdf:value 1 ] ;
		lv2:scalePoint [ rdfs:label "D" ; rdf:value 2 ] ;
		lv2:scalePoint [ rdfs:label "D#" ; rdf:value 3 ] ;
		lv2:scalePoint [ rdfs:label "E" ; rdf:value 4 ] ;
		lv2:scalePoint [ rdfs:label "F" ; rdf:value 5 ] ;
		lv2:scalePoint [ rdfs:label "F#" ; rdf:value 6 ] ;
		lv2:scalePoint [ rdfs:label "G" ; rdf:value 7 ] ;
		lv2:scalePoint [ rdfs:label "G#" ; rdf:value 8 ] ;
		lv2:scalePoint [ rdfs:label "A" ; rdf:value 9 ] ;
		lv2:scalePoint [ rdfs:label "A#" ; rdf:value 10 ] ;
		lv2:scalePoint [ rdfs:label "B" ; rdf:value 11 ]
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 14 ;
		lv2:symbol "transpose" ;
		lv2:name "Transpose" ;
		lv2:portProperty lv2:integer ;
		lv2:default 0 ;
		lv2:minimum -24 ;
		lv2:maximum 24
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 15 ;
		lv2:symbol "splitnote" ;
		lv2:name "Split Note (0 = Off)" ;
		lv2:portProperty lv2:integer ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 127
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 16 ;
		lv2:symbol "lowchan" ;
		lv2:name "Low Channel" ;
		lv2:portProperty lv2:integer ;
		lv2:default 1 ;
		lv2:minimum 1 ;
		lv2:maximum 16
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 17 ;
		lv2:symbol "highchan" ;
		lv2:name "High Channel" ;
		lv2:portProperty lv2:integer ;
		lv2:default 1 ;
		lv2:minimum 1 ;
		lv2:maximum 16
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 18 ;
		lv2:symbol "tuning" ;
		lv2:name "Tuning (semitones)" ;
		lv2:portProperty lv2:integer ;
		lv2:default 0 ;
		lv2:minimum -12 ;
		lv2:maximum 12
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 19 ;
		lv2:symbol "enabled" ;
		lv2:name "Enabled" ;
		lv2:designation lv2:enabled ;
		lv2:portProperty lv2:toggled ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1
	], [
		a lv2:InputPort, atom:AtomPort ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent ;
		lv2:index 20 ;
		lv2:symbol "midiin" ;
		lv2:name "MIDI In"
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 21 ;
		lv2:symbol "mpe" ;
		lv2:name "MPE Output" ;
		lv2:portProperty lv2:integer, lv2:toggled ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 22 ;
		lv2:symbol "bendrange" ;
		lv2:name "Bend Range (semitones)" ;
		lv2:default 2.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 24.0
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 23 ;
		lv2:symbol "perstring" ;
		lv2:name "One Note Per String" ;
		lv2:portProperty lv2:integer, lv2:toggled ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1
	] .

<http://github.com/geraldmwangi/GuitarMidi-LV2#ui>
    ui:portNotification [
        ui:plugin <http://github.com/geraldmwangi/GuitarMidi-LV2> ;
        lv2:symbol "debugdata" ;
        ui:protocol atom:eventTransfer
    ] .

