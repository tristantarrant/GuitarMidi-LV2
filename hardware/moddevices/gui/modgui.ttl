@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

# MOD Devices GUI for the GuitarMidi-LV2 plugin.
#
# Custom (hand-written) icon template + stylesheet instead of one of the stock
# "N-knobs" panels: the plugin has 18 control ports, which no stock panel can
# hold.  The template binds every widget to its LV2 port by symbol, so the
# lv2:index entries below are the *widget* indices of the MODGUI spec (they
# order the ports in the GUI), not the LV2 port indices of guitarmidi.ttl.
#
# Not exposed as widgets: "enabled" (host bypass, driven by the footswitch) and
# "midiin" (a port, not a control).  The input level meter is fed by the plugin's
# two meter output ports ("inlevel"/"inpeak"): modgui:monitoredOutputs makes the
# host push their values into the gui script, which moves the meter bar.  The
# desktop UI keeps using the debug packet instead.
#
# Layout mirrors ui/guitarmidi_ui.cpp: INPUT, NOTE ONSET, NOTE OFFSET,
# NOTE FILTER, ROUTING, TRACKING.  Artwork is generated by
# tools/gen_modgui_art.py; see README for the widget map.

<http://github.com/geraldmwangi/GuitarMidi-LV2>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-guitar-midi.html> ;
        modgui:stylesheet <modgui/stylesheet-guitar-midi.css> ;
        modgui:javascript <modgui/script-guitar-midi.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "Drift Audio" ;
        modgui:label "Guitar Midi" ;

        # Output control ports the gui shows: post-gain input level in dBFS,
        # block RMS and block peak (-80 ... 0).  Pushed to the javascript as
        # event.ports / event.symbol + event.value.
        modgui:monitoredOutputs [ lv2:symbol "inlevel" ] , [ lv2:symbol "inpeak" ] ;

        modgui:port [
            lv2:index 0 ;
            lv2:symbol "gain" ;
            lv2:name "Input Gain (dB)" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "expressivity" ;
            lv2:name "Expressivity Range (dB)" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "onsetsmoothing" ;
            lv2:name "Onset Smoothing" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "onsetconfthr" ;
            lv2:name "Onset Confidence Threshold" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "onsetlevel" ;
            lv2:name "Onset Level (dBFS)" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "offsetsmoothing" ;
            lv2:name "Offset Smoothing" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "offsetconfthr" ;
            lv2:name "Offset Confidence Threshold" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "offsetlevel" ;
            lv2:name "Offset Level (dBFS)" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "scale" ;
            lv2:name "Scale" ;
        ] , [
            lv2:index 9 ;
            lv2:symbol "scaleroot" ;
            lv2:name "Scale Root" ;
        ] , [
            lv2:index 10 ;
            lv2:symbol "transpose" ;
            lv2:name "Transpose" ;
        ] , [
            lv2:index 11 ;
            lv2:symbol "splitnote" ;
            lv2:name "Split Note (0 = Off)" ;
        ] , [
            lv2:index 12 ;
            lv2:symbol "lowchan" ;
            lv2:name "Low Channel" ;
        ] , [
            lv2:index 13 ;
            lv2:symbol "highchan" ;
            lv2:name "High Channel" ;
        ] , [
            lv2:index 14 ;
            lv2:symbol "tuning" ;
            lv2:name "Tuning (semitones)" ;
        ] , [
            lv2:index 15 ;
            lv2:symbol "mpe" ;
            lv2:name "MPE Output" ;
        ] , [
            lv2:index 16 ;
            lv2:symbol "bendrange" ;
            lv2:name "Bend Range (semitones)" ;
        ] , [
            lv2:index 17 ;
            lv2:symbol "perstring" ;
            lv2:name "One Note Per String" ;
        ] ;
    ] .
